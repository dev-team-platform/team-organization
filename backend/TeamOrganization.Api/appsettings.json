{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.File"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information",
        "System": "Warning"
      }
    },
    "Enrich": ["FromLogContext"],
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/app-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "YOUR_DB_CONNECTION_STRING (string)"
  },
  "Redis": {
    "ConnectionString": "YOUR_REDIS_CONNECTION_STRING (string)"
  },
  "Auth": {
    "KeycloakForAdminApi": {
      "Authority": "YOUR_KEYCLOAK_AUTHORITY_URL (string)",
      "ClientId": "YOUR_KEYCLOAK_CLIENT_ID (string)",
      "ClientSecret": "YOUR_KEYCLOAK_CLIENT_SECRET (string)"
    },
    "InternalJwt": {
      "Issuer": "YOUR_INTERNAL_JWT_ISSUER (string)",
      "Audience": "YOUR_INTERNAL_JWT_AUDIENCE (string)",
      "PublicKeyPemPath": "YOUR_INTERNAL_JWT_PUBLIC_KEY_PEM_PATH(string)"
    }
  },
  "RabbitMq": {
    "Host": "YOUR_RABBITMQ_HOST (string)",
    "Port": "YOUR_RABBITMQ_PORT (int)",
    "Username": "YOUR_RABBITMQ_USERNAME (string)",
    "Password": "YOUR_RABBITMQ_PASSWORD (string)",
    "VirtualHost": "YOUR_RABBITMQ_VIRTUAL_HOST (string)",
    "Retry": {
      "AttemptHeader": "x-retry-attempt",
      "Exchange": "team.organization.retry",
      "ReturnExchange": "team.organization.retry.return",
      "DeadLetterExchange": "team.organization.dlx",
      "Delays": [
        {
          "Name": "10s",
          "MessageTtlMilliseconds": 10000
        },
        {
          "Name": "1m",
          "MessageTtlMilliseconds": 60000
        },
        {
          "Name": "10m",
          "MessageTtlMilliseconds": 600000
        }
      ]
    },
    "Consumers": {
      "UserLoggedIn": {
        "Queue": "team.organization.auth-events.q",
        "PrefetchCount": 10,
        "ReconnectDelaySeconds": 5,
        "Bindings": [
          {
            "Exchange": "team.gateway.auth.events",
            "ExchangeType": "topic",
            "RoutingKeys": ["user.logged-in.v1"]
          }
        ]
      }
    },
    "Publishers": {
      "OrganizationEvents": {
        "Exchange": "team.organization.events",
        "ExchangeType": "topic"
      }
    }
  },
  "RateLimiter": {
    "Default": {
      "TokenLimit": 200,
      "TokensPerPeriod": 100,
      "ReplenishmentPeriod": "00:00:10",
      "QueueLimit": 0
    }
  },
  "UserManagement": {
    "DefaultPassword": "YOUR_DEFAULT_PASSWORD (string)"
  },
  "AuditLog": {
    "RetryCount": 3,
    "RetryDelayInMsSeconds": [1000, 5000, 10000],
    "JitterFromMsSeconds": 1000,
    "JitterToMsSeconds": 3000
  }
}
